FROM node:22-trixie-slim
# run_cli と run_agent（Claude Code）の実行場所。外向きの通信は DO 側で無効にし、
# api.anthropic.com だけを outbound handler 経由で通す。
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git ripgrep python3 python3-openpyxl python3-pypdf \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g @anthropic-ai/claude-code@2.1.319 && npm cache clean --force
RUN useradd --create-home --uid 1001 agent
CMD ["sleep", "infinity"]
